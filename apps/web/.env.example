# Desarrollo local: copiar a apps/web/.env y completar. Nunca versionar el .env real.
# Postgres de desarrollo: docker compose -f infra/docker-compose.dev.yml up -d

DATABASE_URL=postgresql://afuch:afuch@localhost:5433/afuch

# Claves (generar cada una; no reutilizar las de producción):
CLAVE_CIFRADO=              # openssl rand -base64 32
CLAVE_HMAC=                 # openssl rand -base64 32  (distinta de CLAVE_CIFRADO)
NEXTAUTH_SECRET=            # openssl rand -base64 48
NEXTAUTH_URL=http://localhost:3000

# Correo. Sin RESEND_API_KEY los correos se imprimen en la consola (solo desarrollo;
# en producción es obligatoria).
RESEND_API_KEY=
# CORREO_REMITENTE=AFUCH Servicios Centrales <no-responder@afuchscen.cl>
# CORREO_CONTACTO_DESTINO=contacto@afuchscen.cl
# Guarda cada correo como archivo JSON (útil para copiar enlaces de verificación):
# CORREO_BUZON_DIR=./.buzon

# Carpeta de los PDF de rendición de cuentas.
STORAGE_DIR=./storage
