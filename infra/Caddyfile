# HTTPS automático con Let's Encrypt para ambos nombres. El sitio canónico es
# www.<DOMINIO>; el dominio desnudo redirige ahí. Caddy agrega la IP real del
# cliente como X-Forwarded-For (y descarta la que envíe el cliente), que la app
# usa para el rate limiting y la auditoría.
www.{$DOMINIO} {
	encode zstd gzip
	reverse_proxy web:3000
}

{$DOMINIO} {
	redir https://www.{$DOMINIO}{uri} permanent
}
