# Copiar a infra/.env en el VPS (permisos 600). Nunca versionar infra/.env.

DOMINIO=afuchservicioscentrales.cl

POSTGRES_USER=afuch
POSTGRES_PASSWORD=          # openssl rand -base64 24
POSTGRES_DB=afuch

# Claves de la aplicación. Generar cada una con: openssl rand -base64 32
# Perderlas deja ilegibles los datos cifrados: guardarlas también fuera del VPS.
CLAVE_CIFRADO=
CLAVE_HMAC=
NEXTAUTH_SECRET=            # openssl rand -base64 48
NEXTAUTH_URL=https://afuchservicioscentrales.cl

RESEND_API_KEY=
CORREO_REMITENTE=AFUCH Servicios Centrales <no-responder@afuchservicioscentrales.cl>
CORREO_CONTACTO_DESTINO=contacto@afuchservicioscentrales.cl
