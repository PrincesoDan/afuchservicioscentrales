# Copiar a infra/.env en el VPS (permisos 600). Nunca versionar infra/.env.

# Dominio sin www; el sitio se sirve en www.<DOMINIO> y el dominio desnudo redirige ahí.
DOMINIO=afuchscen.cl

POSTGRES_USER=afuch
# En hexadecimal: va dentro de DATABASE_URL y los «/» o «+» de base64 rompen la URL.
POSTGRES_PASSWORD=          # openssl rand -hex 24
POSTGRES_DB=afuch

# Claves de la aplicación. Generar cada una con: openssl rand -base64 32
# Perderlas deja ilegibles los datos cifrados: guardarlas también fuera del VPS.
CLAVE_CIFRADO=
CLAVE_HMAC=
NEXTAUTH_SECRET=            # openssl rand -base64 48
NEXTAUTH_URL=https://www.afuchscen.cl

RESEND_API_KEY=
CORREO_REMITENTE=AFUCH Servicios Centrales <contacto@afuchscen.cl>
CORREO_CONTACTO_DESTINO=contacto@afuchscen.cl
